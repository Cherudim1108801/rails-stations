<h1>新規の上映スケジュールを追加</h1>

<%= form_with model: [ :admin, @schedule] do |form| %>
    <div>
        <%= form.label :movie_id, "映画ID" %><%= form.number_field :movie_id %><br>
        <%= form.label :start_time, "開始時刻" %><%= form.time_field :start_time %><br>
        <%= form.label :end_time, "終了時刻" %><%= form.time_field :end_time %><br>
    </div>
    <div>
        <%= form.submit %>
    </div>
<% end %>