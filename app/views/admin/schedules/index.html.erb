
<head>
    <title>上映映画スケジュール一覧</title>
    <meta charset="UTF-8">
</head>
<body>
    <h1>上映映画スケジュール一覧</h1>
    <div>
        <%= button_to "新規", {controller: 'admin/schedules', action: 'new'}, {method: :get} %>
    </div>
    <br>
    <table border="1">
        <tr>
            <th>ID</th>
            <th>映画名</th>
            <th>開始時刻</th>
            <th>終了時刻</th>
            <th>作成日時</th>
            <th>更新日時</th>
        <tr>
        <% @schedules.each do |schedule|%>
            <tr>
                <td><%= link_to schedule.id, admin_schedule_path(schedule) %></td>
                <td><%=schedule.name%></td>
                <td><%=(schedule.start_time).strftime("%H:%M")%></td>
                <td><%=(schedule.end_time).strftime("%H:%M")%></td>
                <td><%=schedule.created_at.strftime("%Y/%m/%d %H:%M") %></td>
                <td><%=schedule.updated_at.strftime("%Y/%m/%d %H:%M") %></td>
            </tr>
        <% end %>
    </table>
</body>