<h1>上映スケジュールの編集</h1>

<%= form_with model: [ :admin, @schedule] do |form| %>
    <div>
        <%= form.label :movie_id, "映画ID" %><%= form.number_field :movie_id, readonly: true %><br>
        <%= form.label :start_time, "開始時刻" %><%= form.time_field :start_time %><br>
        <%= form.label :end_time, "終了時刻" %><%= form.time_field :end_time %><br>
    </div>
    <div>
        <%= form.submit %>
    </div>
    
<% end %>

<div>
    <%= button_to "削除", admin_schedule_path(@schedule), method: :delete, data: { confirm: "本当に削除しますか？" }%>
</div>