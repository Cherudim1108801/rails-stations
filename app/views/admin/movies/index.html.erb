<title>上映映画一覧</title>
<meta charset="UTF-8">
<h1>上映映画一覧</h1>
<div>
    <%= button_to "新規", {controller: 'admin/movies', action: 'new'}, {method: :get} %>
</div>
<br>
<table border="1">
    <tr>
        <th>ID</th>
        <th>タイトル</th>
        <th>公開年</th>
        <th>概要</th>
        <th>画像URL</th>
        <th>上映中</th>
        <th>上映開始時刻</th>
        <th>登録日時</th>
        <th>更新日時</th>
    </tr>
    <% @movies.each do |movie|%>
    <tr>
        <td><a href="/admin/movies/<%=movie.id%>/edit"><%=movie.id%></a></td>
        <td><%=movie.name%></td>
        <td><%=movie.year%></td>
        <td><%=movie.description%></td>
        <td>
            <%= image_tag movie.image_url %>
        </td>
        <td><%=movie.is_showing ? "上映中" : "上映予定"%></td>
        <td><%=movie.schedules.order(:start_time).first&.start_time %></td>
        <td><%=movie.created_at.strftime("%Y/%m/%d %H:%M") %></td>
        <td><%=movie.updated_at.strftime("%Y/%m/%d %H:%M") %></td>
    </tr>
    <% end %>
</table>